{
  "manifest_version": 3,
  "name": "Vigia de Preço — Mercado Livre",
  "version": "1.3.0",
  "description": "Consulta ofertas do Mercado Livre para o Vigia de Preço neste computador.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://lista.mercadolivre.com.br/*",
    "https://www.mercadolivre.com.br/*",
    "https://produto.mercadolivre.com.br/*",
    "https://mercadolivre.com.br/*"
  ],
  "background": {
    "service_worker": "vigia.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "painel.js"
      ],
      "run_at": "document_start"
    }
  ]
}
